//table_name_prefix = "ag_{{componentName}}_"
pub fn up(table_name_prefix: &str) -> Vec<String> {
    let mut queries = vec![];
    // language=SQL

    // ENABLE UUID EXTENSION
    queries.push("CREATE EXTENSION IF NOT EXISTS \"uuid-ossp\";".to_string());

    // CREATE {{entityName}} DQL
    queries.push(format!(
        r#"
            CREATE TABLE {prefix}{{snake entityName}} (
                id uuid PRIMARY KEY
            );
        "#,
        prefix = table_name_prefix
    ));

    queries
}
