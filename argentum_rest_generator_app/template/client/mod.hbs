{{#each useResponses as |response|}}
    use crate::dto::response::{{upper_camel response}}Response;
{{/each}}
{{#each useSchemas as |schema|}}
    use crate::dto::schema::{{upper_camel schema}} as {{upper_camel schema}}Schema;
{{/each}}

{{#each paths as |path|}}
    {{#each path.operations as |operation|}}
    use crate::dto::request::{{upper_camel operation.operationId}}Request;
    use crate::dto::operation_response_enum::{{ upper_camel operation.operationId }}OperationResponseEnum;
    {{/each}}
{{/each}}

{{#if securityEnabled}}use argentum_user_business::entity::user::User;{{/if}}


{{!-- {{#if securityEnabled}} --}}
{{!-- use argentum_user_business::entity::user::User; --}}
{{!-- {{/if}} --}}

use reqwest::StatusCode;

pub struct Client {
    server_url: String, base_path: String
}

impl Client {
    pub fn new(
        server_url: String, base_path: String
    ) -> Self {
        Self { server_url, base_path }
    }

    {{#each paths as |path|}}
        {{#each path.operations as |operation| }}
        pub async fn {{snake operation.operationId}}(
            &self,
            req: {{ upper_camel operation.operationId }}Request,
            //TODO: need some way to deal with anonymous/authorized users
{{!--             {{#if operation.security}}_user: User,{{/if}} --}}
        ) -> Result<{{ upper_camel operation.operationId }}OperationResponseEnum, String> {
            //TODO: use better type instead of Err(String)

            {{!-- //let raw_query_params = HashMap::from([]);
            //let req: {{upper_camel operation.operationId}}Request = self
            //    .request_transformer
            //    .transform(request, raw_path_params, raw_query_params)
            //    .await?; --}}
            {{#if operation.security}}
            //TODO: deal with security
    {{!--             let user = self.bearer_auth.auth(&req.params.headers)?; --}}
    {{!--             let r = self.{{snake operation.operationId}}.handle(req, user)?; --}}
            {{else}}
            //    let r = self.{{snake operation.operationId}}.handle(req)?;
            {{/if}}


            let client = reqwest::Client::new();

            let mut url_tpl = "{{path.url}}".to_string();

            {{#each operation.parameters as |param|~}}
            url_tpl = url_tpl.replace(
                "{ {{~param.name~}} }",
                req.params.path.{{snake param.name}}.to_string().as_str(),
            );
            {{/each}}

            let url = format!("{}{}{}", self.server_url, self.base_path, url_tpl);

            {{#if operation.needBody}}
            let body = serde_json::to_vec_pretty(&req.body).unwrap();
            {{/if}}
            //TODO: params: header, query, auth

            //TODO: transform {{ upper_camel operation.operationId }}Request into reqwest object
            let res = client
                .{{lower operation.method}}(url)
                .header("Accept", "application/json")
                {{#if operation.security}}
                .header(
                    "authorization",
                    format!("Bearer {}", req.params.headers.authorization),
                )
                {{/if}}
                {{#if operation.needBody}}
                .body(body)
                {{/if}}
                .send()
                .await;

            match res {
                Ok(response) => {
                    match response.status() {
                        {{#each operation.responses as |resp| }}
                        StatusCode::{{resp.statusName}} => {
                            {{#each resp.content as |content| }}
                                {{#if (eq content.contentType "application/json") }}
                                match response.json::<{{content.schemaName}}Schema>().await {
                                    Ok(data) => Ok({{ upper_camel operation.operationId }}OperationResponseEnum::Status{{resp.statusCode}}(
                                        {{resp.responseName}}Response::new_application_json(data),
                                    )),
                                    Err(e) => Err(e.to_string()),
                                }
                                {{else if (eq content.contentType "application/problem+json") }}
                                match response.json::<{{content.schemaName}}Schema>().await {
                                    Ok(data) => Ok({{ upper_camel operation.operationId }}OperationResponseEnum::Status{{resp.statusCode}}(
                                        {{resp.responseName}}Response::new_application_problem_json(data),
                                    )),
                                    Err(e) => Err(e.to_string()),
                                }
                                {{/if}}
                            {{/each}}
                        },
                        {{/each}}

                        _ => Err("Wrong status code".to_string()),
                    }
                },
                Err(e) => Err(e.to_string()),
            }
        }

        {{/each}}
    {{/each}}
}
