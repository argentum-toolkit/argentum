[package]
name = "{{ packageName }}"
description = "{{ description }}"
version = "{{ version }}"
{{#if license}}
license = "{{ license.name }}"
{{#if license.url}}
license-file = "{{ license.url }}"
{{/if}}
{{/if}}
edition = "2024"

{{#if homepage}}
homepage = "{{ homepage }}"
{{/if}}
{{#if repository}}
repository = "{{ repository }}"
{{/if}}
{{#if documentation}}
documentation = "{{ documentation }}"
{{/if}}
readme = "README.md"

# See more keys and their definitions at https://doc.rust-lang.org/cargo/reference/manifest.html

[features]
client = ["dep:reqwest"]
server = ["dep:hyper"]
ui = ["dep:dioxus", "dep:dioxus-logger", "dep:argentum_standard_infrastructure", "dep:argentum_standard_ui"]
web = ["dioxus/web", "argentum_standard_ui/web"]

[dependencies]
argentum_rest_infrastructure = { {{#if argentumPath}}path = "{{argentumPath}}/argentum_rest/infrastructure", {{/if}}version = ">=0.3.0,<0.4.0" }
argentum_standard_business = { {{#if argentumPath}}path = "{{argentumPath}}/argentum_standard/business", {{/if}}version = ">=0.3.0,<0.4.0" }
argentum_standard_infrastructure = { {{#if argentumPath}}path = "{{argentumPath}}/argentum_standard/infrastructure", {{/if}}version = ">=0.3.0,<0.4.0", optional = true }
argentum_standard_ui = { {{#if argentumPath}}path = "{{argentumPath}}/argentum_standard/ui", {{/if}}version = ">=0.3.0,<0.4.0", optional = true }
argentum_user_business = { {{#if argentumPath}}path = "{{argentumPath}}/argentum_user/business", {{/if}}version = ">=0.3.0,<0.4.0" }

async-trait = "0.1.*"
chrono = "0.4.*"
dioxus = { version = "0.6", features = ["fullstack", "router"], optional = true }
dioxus-logger = { version = "0.6", optional = true }
erased-serde = "0.4.*"
http = "1.*"
hyper = { version = "1.*", features = ["full"], optional = true }
regex = "1.10.*"
compiletime-regex = "1.0.*"
reqwest = { version = "0.12.*", features = ["json"], optional = true}
serde = { version = "1.0.*", features = ["derive"] }
serde_json = "1.0.133"
serde_valid = "1.*"
uuid = { version = "1.*", features = ["serde", "v4", "js"] }
