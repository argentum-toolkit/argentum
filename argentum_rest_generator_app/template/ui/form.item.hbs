{{#if schemaName}}
use crate::dto::schema::{{ upper_camel schemaName}};
use crate::ui::input::{{ upper_camel schemaName}}Input;
{{/if}}
use crate::ui::form_data::{{operation.operationId}}FormProps;

use argentum_standard_ui::rsx::form::{LabeledInput, Submit};
use argentum_standard_ui::rsx::ErrorBlock;

use dioxus::prelude::*;

#[component]
pub fn {{operation.operationId}}Form(props: {{operation.operationId}}FormProps) -> Element {
    let mut form_data = props.form_data;

    rsx! {
        form {
            action:"#",
            class:"space-y-6",
            "novalidate": true,
            onsubmit: props.on_submit,

            ErrorBlock {errors: (form_data.errors)()}

            {{#if schemaName}}
            {{ upper_camel schemaName}}Input {
                {{ snake schemaName}}: (form_data.values)().into(),
                violations: (form_data.violations)(),
                oninput: move |event: {{ upper_camel schemaName}}| {
                    form_data.values.set(event);
                },
            }
            {{/if}}

            Submit {
                title: "Sign In".to_string(),
                disabled: (form_data.disabled)(),
            }
        }
    }
}
