LabeledInput {
    id: "{{ui.id}}",
    name: "{{ui.name}}",
    label: "{{ui.label}}",           
    input_type: "text".to_string(),
    {{#if required}}
        value: {{name}}_value,
    {{else}}
        value: {{name}}_value().unwrap_or("".to_string()),
    {{/if}}
    
    violations: {{name}}_violations,
    oninput: move |event: String| {
        {{#if required}}
        {{name}}_value.set(event);
        {{else}}
        {{name}}_value.set(Some(event));
        {{/if}}
        update();
    },
}
