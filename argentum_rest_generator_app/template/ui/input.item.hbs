use std::collections::BTreeMap;

use crate::dto::schema::{{ upper_camel name}};

use argentum_standard_infrastructure::invariant_violation::{ViolationItemDto, ViolationsDto};
{{# each dependencies as |dep|}}
use {{dep}};
{{/each}}
use dioxus::prelude::*;

#[derive(PartialEq, Props, Clone)]
pub struct {{ upper_camel name}}Props {
    pub value: {{ upper_camel name}},
    pub violations: Option<ViolationsDto>,
    pub ui_wrapper: String,
    pub title: Option<String>,

    processor: {{ upper_camel name}}InputProcessor,

    oninput: EventHandler<{{ upper_camel name}}>,
}

#[derive(Clone, PartialEq, Default)]
pub struct {{ upper_camel name}}InputProcessor {
    {{#each inputs as |input|}}
    pub {{snake input.key}}_processor: {{ upper_camel inputName}}Processor,
    {{/each}}
}

#[component]
pub fn {{ upper_camel name}}Input(props: {{ upper_camel name}}Props) -> Element {
    let label_class = match props.violations {
        Some(_) => "text-error",
        None => "",
    };

    let {{ upper_camel name}}Props {
        value,
        violations,
        processor,
        ui_wrapper,
        title,
        ..
    } = props.clone();

    {{#each inputs as |input|}}
    let mut {{snake input.key}}_value = use_signal(|| value.{{snake input.key}});
    {{/each}}

    let violation_items = match violations {
        Some(vv) => match vv.items {
            Some(ViolationItemDto::Object(items)) => items,
            _ => BTreeMap::new(),
        },
        None => BTreeMap::new(),
    };

    {{#each inputs as |input|}}
    let {{snake input.key}}_violations = violation_items.get("{{snake input.key}}").cloned();
    {{/each}}

    let update = move || {
        props
            .oninput
            .call({{ upper_camel name}}::new(
            {{#each inputs as |input|}}
                {{snake input.key}}_value(),
            {{/each}}
            ))
    };

    if ui_wrapper.eq("flex") {
        rsx! {
            fieldset {
                if let Some(t) = title {
                    legend { class: "fieldset-legend {label_class}", "{t}"}
                }
                div {
                    class: "flex gap-2",
                    {{#each inputs as |input|}}
                    {{{input.value}}}
                    {{/each}}
                }
            }
        }
     } else if ui_wrapper.eq("block") {
        rsx! {
            fieldset {
                if let Some(t) = title {
                    legend { class: "fieldset-legend {label_class}", "{t}"}
                }
                div {
                    {{#each inputs as |input|}}
                    {{{input.value}}}
                    {{/each}}
                }
            }
        }
    } else {
        rsx! {
            {{#each inputs as |input|}}
            {{{input.value}}}
            {{/each}}
        }
    }
}
