pub struct Values {
    {{#each properties as |property|}}
    pub {{@key}}: Signal<{{property.dataType}}>,
    {{/each}}
}

impl Values {
    pub fn new() -> Self {
        Self {
            {{#each properties as |property|}}
            {{@key}}: use_signal(|| {{property.defaultInitializer}}),
            {{/each}}
        }
    }
}
{{#if schemaName}}
impl Into<{{schemaName}}> for Values {
    fn into(self) -> {{schemaName}} {
        {{schemaName}} {
            {{#each properties as |property|}}
            {{@key}}: (self.{{@key}})(),
            {{/each}}
        }
    }
}
{{/if}}

