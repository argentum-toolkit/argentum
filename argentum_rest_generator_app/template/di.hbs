{{#each operations as |operation|}}
use crate::server::handler::{{upper_camel operation.operationId}}Trait;
{{/each}}

use crate::server::{PreHandler, Router};
use argentum_rest_infrastructure::service::{
{{#if securityEnabled}}
    BearerAuthenticator,
{{/if}}
    ErrorPreHandler, RequestTransformer,
};
use argentum_standard_business::data_type::id::Id;
use argentum_standard_business::di_container::Container;
use std::sync::Arc;

pub fn {{package_name_to_container_provider_name packageName}}<I>(container: &mut Container, url_prefix: &'static str)
where
    I: Id + 'static,
{
    container.provide_factory::<Router<I>, _>(|c| {
        let request_transformer = c.resolve::<RequestTransformer>()?;
        {{#if securityEnabled}}
        let bearer_auth = c.resolve::<BearerAuthenticator<I>>()?;
        {{/if}}
        {{#each operations as |operation|}}
        let {{snake operation.operationId}}_handler =
            c.resolve::<dyn {{upper_camel operation.operationId}}Trait<Id = I>>()?;
        {{/each}}
        let error_pre_handler = c.resolve::<ErrorPreHandler>()?;

        let pre_handler = Arc::new(PreHandler::new(
            request_transformer,
            {{#if securityEnabled}}
            bearer_auth,
            {{/if}}
            {{#each operations as |operation|}}
            {{snake operation.operationId}}_handler,
            {{/each}}
        ));

        Ok(Arc::new(Router::new(
            pre_handler,
            error_pre_handler,
            url_prefix,
        )))
    });
}
