{{~#each operations as |operation|~}}
    use crate::server::handler::{{upper_camel operation.operationId}}Trait;
{{~/each~}}

use crate::server::{PreHandler, Router};
use argentum_rest_infrastructure::service::{
{{#if securityEnabled}}
    BearerAuthenticator,
{{/if}}
    ErrorPreHandler, RequestTransformer,
};
use argentum_standard_business::data_type::id::Id;
use std::sync::Arc;

pub struct ApiDi<I>
where
    I: Id,
{
    pub router: Arc<Router<I>>,
}

impl<I> ApiDi<I>
where
    I: Id,
{
    pub fn new(
        //config
        url_prefix: &str,
        //services
        request_transformer: Arc<RequestTransformer>,
        {{#if securityEnabled}}
            bearer_auth: Arc<BearerAuthenticator<I>>,
        {{/if}}
        {{#each operations as |operation|}}
            {{snake operation.operationId}}_handler: Arc<dyn {{upper_camel operation.operationId}}Trait<Id = I>>,
        {{/each}}
        error_pre_handler: Arc<ErrorPreHandler>,
    ) -> Self {
        let pre_handler = Arc::new(PreHandler::new(
            request_transformer,
            {{#if securityEnabled}}
            bearer_auth,
            {{/if}}
            {{#each operations as |operation|}}
                {{snake operation.operationId}}_handler,
            {{/each}}
        ));

        let router = Arc::new(Router::new(
            pre_handler,
            error_pre_handler,
            url_prefix,
        ));

        ApiDi { router }
    }
}
