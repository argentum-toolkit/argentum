COMPOSE_PROJECT_NAME=argentum
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=devops/docker/cors/docker-compose.yaml:devops/docker/open-api/docker-compose.yaml:devops/docker/builder/docker-compose.yaml:devops/docker/api/docker-compose.yaml:devops/docker/user/docker-compose.yaml:devops/docker/user-account/docker-compose.yaml:devops/docker/oidc/docker-compose.yaml
# :devops/docker/keycloak/docker-compose.yaml

# REDIRECT URL: frontend will add GET parameter `?provider=ProviderName`
AG_OIDC_REDIRECT_URL=http://localhost:8080/oidc/auth/callback


# PostgreSQL specific
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB_FOR_ARGENTUM_USER=argentum_user
POSTGRES_DB_FOR_ARGENTUM_USER_ACCOUNT=argentum_user_account
POSTGRES_DB_FOR_ARGENTUM_OIDC=argentum_oidc

AG_USER_DATABASE_URL=postgres://dev:dev@service.user.db:5432/argentum_user
AG_USER_ACCOUNT_DATABASE_URL=postgres://dev:dev@service.user_account.db:5432/argentum_user_account
AG_OIDC_DATABASE_URL=postgres://dev:dev@service.oidc.db:5432/argentum_oidc

AG_USER_ACCOUNT_MEMBER_JWT_SECRET=super-jwt-secret

AG_USER_AGENT=ArgentumToolKit/0.4
AG_PRODUCT_NAME=Argentum ToolKit. Example of API application
AG_RESTORE_PASSWORD_FRONT_URL=http://localhost:8082/change-password/

AG_GITHUB_CLIENT_ID=test-github-client-id
AG_GITHUB_CLIENT_SECRET=test-client-secret
AG_GOOGLE_CLIENT_ID=test-google-client-id
AG_GOOGLE_CLIENT_SECRET=test-client-secret


