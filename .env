COMPOSE_PROJECT_NAME=argentum
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=devops/docker/cors/docker-compose.yaml:devops/docker/open-api/docker-compose.yaml:devops/docker/builder/docker-compose.yaml:devops/docker/api/docker-compose.yaml:devops/docker/user/docker-compose.yaml:devops/docker/user-account/docker-compose.yaml:devops/docker/keycloak/docker-compose.yaml

# PostgreSQL specific
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB_FOR_ARGENTUM_USER=argentum_user
POSTGRES_DB_FOR_ARGENTUM_USER_ACCOUNT=argentum_user_account

AG_USER_DATABASE_URL=postgres://dev:dev@service.user.db:5432/argentum_user
AG_USER_ACCOUNT_DATABASE_URL=postgres://dev:dev@service.user_account.db:5432/argentum_user_account

LOGIN_URL=http://localhost:8080/user-account/login


# KEYCLOAK

KEYCLOAK_BASE_URL=http://service.keycloak:8080
KEYCLOAK_REALM=argentum-realm-dev
OIDC_REDIRECT_URI=http://localhost:8080/oidc/auth/callback

KEYCLOAK_BE_CLIENT_ID=argentum-be-client-dev
KEYCLOAK_BE_CLIENT_SECRET=dj9cobGEQptoEk5gMvqadYHd6emeUQ2Y
KEYCLOAK_FE_CLIENT_ID=argentum-fe-client-dev
