COMPOSE_PROJECT_NAME=ag

COMPOSE_FILE=docker-compose.yaml

# DEV mode: docker compose --env-file .env --env-file .env.local up
# Optional DEV tooling: docker compose --env-file .env --env-file .env.local --profile swagger up -d swagger-ui

# REDIRECT URL: frontend will add GET parameter `?provider=ProviderName`
AG_OIDC_REDIRECT_URL=http://localhost:8080/oidc/auth/callback


# PostgreSQL specific
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB_FOR_ARGENTUM_USER=argentum_user
POSTGRES_DB_FOR_ARGENTUM_USER_ACCOUNT=argentum_user_account
POSTGRES_DB_FOR_ARGENTUM_OIDC=argentum_oidc

AG_USER_DATABASE_URL=postgres://dev:dev@service.user.db:5432/argentum_user
AG_USER_ACCOUNT_DATABASE_URL=postgres://dev:dev@service.user_account.db:5432/argentum_user_account
AG_OIDC_DATABASE_URL=postgres://dev:dev@service.oidc.db:5432/argentum_oidc

AG_USER_ACCOUNT_MEMBER_JWT_SECRET=super-jwt-secret

AG_USER_AGENT=ArgentumToolKit/0.4
AG_PRODUCT_NAME="Argentum ToolKit. Example of API application"
AG_EMAIL_CONFIRMATION_FRONT_URL=http://localhost:8080/user-account/email-confirmation/?token=
AG_RESTORE_PASSWORD_FRONT_URL=http://localhost:8080/user-account/reset-password/?token=

AG_GITHUB_CLIENT_ID=test-github-client-id
AG_GITHUB_CLIENT_SECRET=test-client-secret
AG_GOOGLE_CLIENT_ID=test-google-client-id
AG_GOOGLE_CLIENT_SECRET=test-client-secret

AG_CAPTCHA_ENABLED=true
AG_CAPTCHA_TURNSTILE_SECRET_KEY=
AG_CAPTCHA_TURNSTILE_SITE_KEY=

TLS_CERT_FILE=
TLS_KEY_FILE=

FE_RELEASE_PATH=target/dx/argentum_example_fe_app/release/web
API_RELEASE_PATH=target/release/api

AG_USER_API_URL=http://localhost:8082
AG_USER_ACCOUNT_API_URL=http://localhost:8082
AG_OIDC_API_URL=http://localhost:8082

# AG_USER_API_URL=https://localhost
# AG_USER_ACCOUNT_API_URL=https://localhost
# AG_OIDC_API_URL=https://localhost


AG_PASSWORD_COMPLEXITY_ENABLED=true
AG_PASSWORD_MIN_LENGTH=8

# AG_USER_API_URL=https://localhost
# AG_USER_ACCOUNT_API_URL=https://localhost
# AG_OIDC_API_URL=https://localhost
# Fallback defaults. Real values are written to .env.local by devops/scripts/setup.sh


HOST_UID=1000
HOST_GID=1000
